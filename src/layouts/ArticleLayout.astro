---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { CollectionEntry } from "astro:content";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  category: string;
  subcategories?: string[];
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  headings: Heading[];
  relatedPosts?: CollectionEntry<"blog">[];
  newerPost?: CollectionEntry<"blog">;
  olderPost?: CollectionEntry<"blog">;
}

const {
  title,
  category,
  subcategories = [],
  pubDate,
  updatedDate,
  tags = [],
  headings,
  relatedPosts = [],
  newerPost,
  olderPost,
} = Astro.props;
const tableOfContents = headings.filter(
  ({ depth }) => depth === 2 || depth === 3,
);
const dateFormat = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const listingDateFormat = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Tokyo",
  }).format(date).replaceAll("/", ".");
---

<Header />
<main class="article-page">
  <div class="article-shell">
    <aside class="toc-sidebar" aria-label="記事の目次">
      <nav class="toc">
        <p class="toc-label">CONTENTS</p>
        <ol>
          {
            tableOfContents.map((heading) => (
              <li class:list={{ "toc-subitem": heading.depth === 3 }}>
                <a href={`#${heading.slug}`} data-toc-link>
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <article class="article-content">
      <header class="article-header">
        <p class="article-category">{category}</p>
        <h1>{title}</h1>
        <div class="article-meta">
          <time datetime={pubDate.toISOString()}
            >{listingDateFormat(pubDate)}</time
          >
          <span class="article-meta-category">{category}</span>
          {subcategories.length > 0 && (
            <>
              <span class="subcategory-separator" aria-hidden="true" />
              {subcategories.map((subcategory) => <span class="subcategory-chip">{subcategory}</span>)}
            </>
          )}
        </div>
        {
          updatedDate && (
            <p class="article-updated">
              更新日 <time datetime={updatedDate.toISOString()}>{dateFormat.format(updatedDate)}</time>
            </p>
          )
        }
        {
          tags.length > 0 && (
            <ul class="article-tags" aria-label="タグ">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      {
        tableOfContents.length > 0 && (
          <details class="mobile-toc">
            <summary>目次を開く</summary>
            <ol>
              {tableOfContents.map((heading) => (
                <li class:list={{ "toc-subitem": heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose"><slot /></div>
      <p class="back-link"><a href="/blog/">記事一覧に戻る</a></p>
      {relatedPosts.length > 0 && (
        <section class="related-articles" aria-labelledby="related-articles-title">
          <h2 id="related-articles-title">関連記事</h2>
          <div class="related-list">
            {relatedPosts.map((post) => (
              <a class="related-card" href={`/blog/${post.id}/`}>
                <h3>{post.data.title}</h3>
                <p class="related-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{listingDateFormat(post.data.pubDate)}</time>
                  <span class="related-category">{post.data.category}</span>
                  {(post.data.subcategories ?? []).map((subcategory) => <span class="related-subcategory">{subcategory}</span>)}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}
      {(olderPost || newerPost) && (
        <nav class="article-navigation" aria-label="前後の記事">
          {olderPost ? <a href={`/blog/${olderPost.id}/`}>← <span>前の記事</span><strong>{olderPost.data.title}</strong></a> : <span />}
          {newerPost ? <a href={`/blog/${newerPost.id}/`} class="next"><span>次の記事</span> →<strong>{newerPost.data.title}</strong></a> : <span />}
        </nav>
      )}
    </article>

    <aside class="ad-space" aria-hidden="true"></aside>
  </div>
</main>
<Footer />
<script>
  const copyCode = async (code: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(code);
      return;
    }

    const textarea = document.createElement("textarea");
    textarea.value = code;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();
    const copied = document.execCommand("copy");
    textarea.remove();
    if (!copied) throw new Error("Copy command was unsuccessful");
  };

  document.querySelectorAll<HTMLElement>(".prose pre").forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code) return;

    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    const button = document.createElement("button");
    button.className = "copy-code-button";
    button.type = "button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "コードをコピー");

    pre.before(wrapper);
    wrapper.append(pre, button);

    button.addEventListener("click", async () => {
      try {
        await copyCode(code.textContent ?? "");
        button.textContent = "Copied!";
        button.setAttribute("aria-label", "コードをコピーしました");
      } catch {
        button.textContent = "Failed";
        button.setAttribute("aria-label", "コードのコピーに失敗しました");
      }

      window.setTimeout(() => {
        button.textContent = "Copy";
        button.setAttribute("aria-label", "コードをコピー");
      }, 2000);
    });
  });

  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
  ];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);
  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const active = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
          )[0];
        if (!active) return;
        links.forEach((link) =>
          link.classList.toggle(
            "is-active",
            link.hash === `#${active.target.id}`,
          ),
        );
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }

  const prose = document.querySelector<HTMLElement>(".prose");
  if (prose) {
    const imageDialog = document.createElement("dialog");
    imageDialog.className = "image-lightbox";
    imageDialog.setAttribute("aria-label", "画像の拡大表示");
    imageDialog.innerHTML = `
      <button class="image-lightbox-close" type="button" aria-label="拡大画像を閉じる">閉じる</button>
      <img class="image-lightbox-image" alt="" />
    `;
    document.body.append(imageDialog);

    const lightboxImage = imageDialog.querySelector<HTMLImageElement>(".image-lightbox-image");
    const closeButton = imageDialog.querySelector<HTMLButtonElement>(".image-lightbox-close");
    let activeImage: HTMLImageElement | null = null;

    const closeLightbox = () => imageDialog.close();
    const openLightbox = (image: HTMLImageElement) => {
      if (!lightboxImage) return;

      activeImage = image;
      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt;
      imageDialog.showModal();
      closeButton?.focus();
    };

    prose.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
      image.tabIndex = 0;
      image.setAttribute("role", "button");
      image.setAttribute("aria-label", image.alt ? `${image.alt}を拡大表示` : "画像を拡大表示");

      image.addEventListener("click", (event) => {
        event.preventDefault();
        openLightbox(image);
      });
      image.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        openLightbox(image);
      });
    });

    closeButton?.addEventListener("click", closeLightbox);
    imageDialog.addEventListener("click", (event) => {
      if (event.target === imageDialog) closeLightbox();
    });
    imageDialog.addEventListener("close", () => {
      lightboxImage?.removeAttribute("src");
      activeImage?.focus();
      activeImage = null;
    });
  }
</script>

<style is:global>
  :root {
    font-family:
      "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
    color: #1f2937;
    background: #fff;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding-right: 24px;
    padding-left: 24px;
  }
  .article-page {
    padding: 32px 24px 72px;
  }
  .article-shell {
    display: grid;
    grid-template-columns: 210px minmax(0, 660px) minmax(120px, 1fr);
    gap: 42px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .toc {
    position: sticky;
    top: 32px;
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    padding-right: 12px;
  }
  .toc-label {
    margin: 0 0 16px;
    color: #6b7280;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .toc ol,
  .mobile-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc li + li {
    margin-top: 10px;
  }
  .toc a,
  .mobile-toc a {
    display: block;
    color: #6b7280;
    font-size: 0.82rem;
    line-height: 1.6;
    text-decoration: none;
  }
  .toc a:hover,
  .toc a.is-active,
  .mobile-toc a:hover {
    color: #3b82f6;
  }
  .toc a.is-active {
    font-weight: 700;
  }
  .toc-subitem {
    padding-left: 14px;
  }
  .article-header {
    padding-bottom: 24px;
    border-bottom: 1px solid #e5e7eb;
  }
  .article-category {
    margin: 0 0 8px;
    color: #3b82f6;
    font-size: 0.84rem;
    font-weight: 700;
  }
  .article-header h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: #6b7280;
    font-size: 0.8rem;
  }
  .article-meta-category { border-left: 1px solid #d1d5db; color: #2563eb; margin-left: 2px; padding-left: 10px; }
  .subcategory-separator { border-left: 1px solid #d1d5db; height: .9em; margin-left: 2px; }
  .subcategory-chip { padding: 2px 7px; color: #2563eb; background: #dbeafe; border-radius: 999px; font-size: .72rem; }
  .article-updated { margin: 7px 0 0; color: #6b7280; font-size: .75rem; }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .article-tags li {
    padding: 4px 10px;
    color: #4b5563;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .mobile-toc {
    display: none;
  }
  .prose {
    padding-top: 28px;
    color: #1f2937;
    font-size: 1rem;
    line-height: 2;
    overflow-wrap: anywhere;
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose h1 {
    display: none;
  }
  .prose h2 {
    margin: 52px 0 20px;
    padding: 10px 0 10px 16px;
    border-left: 4px solid #3b82f6;
    border-bottom: 1px solid #e5e7eb;
    font-size: 1.65rem;
    line-height: 1.55;
  }
  .prose h3 {
    margin: 36px 0 16px;
    font-size: 1.25rem;
    line-height: 1.65;
  }
  .prose p {
    margin: 0 0 1.6em;
  }
  .prose ul,
  .prose ol {
    margin: 0 0 1.6em;
    padding-left: 1.5em;
  }
  .prose li + li {
    margin-top: 0.35em;
  }
  .prose blockquote {
    margin: 1.8em 0;
    padding: 14px 18px;
    color: #4b5563;
    background: #f8fafc;
    border-left: 4px solid #3b82f6;
  }
  .prose code {
    padding: 0.15em 0.4em;
    color: #1f2937;
    background: #f1f5f9;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .prose pre {
    margin: 1.8em 0;
    padding: 20px;
    overflow-x: auto;
    color: #e5e7eb;
    background: #1f2937;
    border-radius: 8px;
    line-height: 1.7;
  }
  .prose .code-block {
    position: relative;
    margin: 1.8em 0;
  }
  .prose .code-block pre {
    margin: 0;
    padding-top: 48px;
  }
  .copy-code-button {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    padding: 5px 9px;
    color: #e5e7eb;
    background: #374151;
    border: 1px solid #6b7280;
    border-radius: 4px;
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.2;
    cursor: pointer;
  }
  .copy-code-button:hover,
  .copy-code-button:focus-visible {
    background: #4b5563;
  }
  .copy-code-button:focus-visible {
    outline: 2px solid #93c5fd;
    outline-offset: 2px;
  }
  .prose pre code {
    padding: 0;
    color: inherit;
    background: transparent;
  }
  .prose table {
    display: block;
    width: 100%;
    margin: 1.8em 0;
    overflow-x: auto;
    border-collapse: collapse;
    white-space: nowrap;
  }
  .prose th,
  .prose td {
    padding: 11px 14px;
    border: 1px solid #e5e7eb;
    text-align: left;
  }
  .prose th {
    background: #f8fafc;
  }
  .prose img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.8em auto;
    border-radius: 8px;
  }
  .prose img[role="button"] {
    cursor: zoom-in;
  }
  .prose img[role="button"]:focus-visible {
    outline: 3px solid #60a5fa;
    outline-offset: 3px;
  }
  .image-lightbox {
    width: min(96vw, 1200px);
    max-width: none;
    max-height: 96vh;
    margin: auto;
    padding: 44px 16px 16px;
    overflow: visible;
    background: transparent;
    border: 0;
  }
  .image-lightbox::backdrop {
    background: rgb(15 23 42 / 0.78);
  }
  .image-lightbox-image {
    display: block;
    max-width: 100%;
    max-height: calc(96vh - 60px);
    margin: 0 auto;
    object-fit: contain;
    border-radius: 6px;
  }
  .image-lightbox-close {
    position: absolute;
    top: 0;
    right: 16px;
    padding: 7px 10px;
    color: #fff;
    background: rgb(31 41 55 / 0.92);
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 4px;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .image-lightbox-close:hover,
  .image-lightbox-close:focus-visible {
    background: #374151;
  }
  .image-lightbox-close:focus-visible {
    outline: 2px solid #bfdbfe;
    outline-offset: 2px;
  }
  .prose a,
  .back-link a {
    color: #3b82f6;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose .point,
  .prose .notice-point {
    margin: 1.8em 0;
    padding: 16px 18px;
    background: #eff6ff;
    border-left: 4px solid #3b82f6;
    border-radius: 4px;
  }
  .prose .warning,
  .prose .notice-warning {
    margin: 1.8em 0;
    padding: 16px 18px;
    background: #fffbeb;
    border-left: 4px solid #facc15;
    border-radius: 4px;
  }
  .back-link {
    margin: 48px 0 0;
    font-size: 0.9rem;
  }
  .related-articles { margin-top: 56px; padding-top: 32px; border-top: 1px solid #e5e7eb; }
  .related-articles > h2 { margin: 0 0 18px; font-size: 1.2rem; }
  .related-list { display: grid; gap: 10px; }
  .related-card { display: block; padding: 15px 16px; color: #1f2937; border: 1px solid #e5e7eb; border-radius: 6px; text-decoration: none; }
  .related-card:hover { border-color: #3b82f6; }
  .related-card h3 { margin: 0 0 8px; font-size: .94rem; line-height: 1.55; }
  .related-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0; color: #6b7280; font-size: .72rem; }
  .related-category { padding-left: 8px; color: #2563eb; border-left: 1px solid #d1d5db; }
  .related-subcategory { padding: 1px 6px; color: #2563eb; background: #dbeafe; border-radius: 999px; font-size: .68rem; }
  .article-navigation { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; margin-top: 32px; padding-top: 24px; border-top: 1px solid #e5e7eb; }
  .article-navigation a { display: grid; grid-template-columns: auto 1fr; gap: 5px 8px; color: #3b82f6; font-size: .8rem; text-decoration: none; }
  .article-navigation a.next { grid-template-columns: 1fr auto; text-align: right; }
  .article-navigation a strong { grid-column: 1 / -1; color: #1f2937; font-size: .82rem; font-weight: 500; line-height: 1.55; }
  @media (max-width: 980px) {
    .article-shell {
      grid-template-columns: 190px minmax(0, 1fr);
      gap: 32px;
    }
    .ad-space {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .container {
      padding-right: 20px;
      padding-left: 20px;
    }
    .article-page {
      padding: 32px 20px 64px;
    }
    .article-shell {
      display: block;
    }
    .toc-sidebar {
      display: none;
    }
    .article-header {
      padding-bottom: 22px;
    }
    .article-header h1 {
      font-size: 1.7rem;
    }
    .mobile-toc {
      display: block;
      margin-top: 24px;
      padding: 0 16px;
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
    }
    .mobile-toc summary {
      padding: 14px 0;
      color: #1f2937;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
    }
    .mobile-toc ol {
      padding: 0 0 16px;
    }
    .mobile-toc li + li {
      margin-top: 8px;
    }
    .prose {
      padding-top: 24px;
      line-height: 1.9;
    }
    .prose h2 {
      margin-top: 48px;
      font-size: 1.4rem;
    }
    .prose h3 {
      margin-top: 36px;
      font-size: 1.14rem;
    }
    .article-navigation { gap: 16px; }
  }
</style>

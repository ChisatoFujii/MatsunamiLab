---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="お問い合わせフォーム" />
    <title>お問い合わせ | Matsunami Automation Works</title>
  </head>
  <body>
    <Header />
    <main>
      <section class="contact-section" aria-labelledby="contact-title">
        <div class="container contact-container">
          <div class="section-heading">
            <p>CONTACT</p>
            <h1 id="contact-title">お問い合わせ</h1>
          </div>
<iframe
  class="contact-form-frame"
  src="https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=M5fnXAkcbUiG3h7GdiO9gnPdbszgZoZOvf_jLqbKesJUQU9YMFpCTFRWT1JDNTJMUk1SVFU2SEhOWS4u&embed=true"
  title="お問い合わせフォーム"
  loading="lazy"
></iframe>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color: #1f2937;
    background: #fff;
    font-family:
      "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
  .container {
    margin: 0 auto;
    max-width: 1200px;
    padding-left: 24px;
    padding-right: 24px;
    width: 100%;
  }
</style>

<style>
  .contact-section {
    background: #f8fafc;
    min-height: calc(100vh - 220px);
    padding: 72px 0;
  }

  .contact-container {
    max-width: 760px;
  }

  .section-heading {
    margin-bottom: 32px;
    text-align: center;
  }

  .section-heading p {
    color: #2563eb;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    margin: 0 0 8px;
  }

  .section-heading h1 {
    color: #1f2937;
    font-size: clamp(1.8rem, 4vw, 2.25rem);
    margin: 0;
  }

  .contact-form-frame {
    border: 0;
    width: 100%;
    height: 900px;
  }

  @media (max-width: 640px) {
    .contact-section {
      padding: 48px 0;
    }
  }
</style>
